{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v virta >/dev/null 2>&1 && virta brief || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v virta >/dev/null 2>&1 && virta brief --changes || true"
          }
        ]
      }
    ]
  }
}
