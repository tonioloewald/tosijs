# Copy to `.env` (gitignored, auto-loaded by bun) and fill in.
# Nothing here is required to build, test, or run the dev server — these only
# configure the preview/tunnel deploy, which is maintainer-only.

# ssh target for `bun run deploy` and `bun run tunnel`. Deploy as a non-root
# user with write access to the served directory; root is not needed.
TOSIJS_PREVIEW_HOST=deploy@preview.example.com
# printed after a successful deploy
TOSIJS_PREVIEW_URL=https://tosijs.dev.example.com
# loopback port to bind on the remote box — hand-picked per box so two
# projects sharing one host don't collide (tosijs-ui#29)
TOSIJS_TUNNEL_PORT=9789
# authenticated public URL fronting the tunnelled dev server
TOSIJS_TUNNEL_URL=https://tosijs.edit.dev.example.com

# Set to 1 to enable the dev server's /__docstore/source write endpoint, which
# backs in-browser "edit page source". Off by default because that endpoint is
# CSRF-able from any page you visit while `bun start` runs (SEC-5; upstream fix
# tracked in UPSTREAM.md). Prefer `TOSI_EDIT=1 bun start` for a single session.
# TOSI_EDIT=1
